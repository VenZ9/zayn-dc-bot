# ============================================================================
#  ZAYN'S DC BOT - environment variables
#  Copy this file to `.env` and fill in the real values.  NEVER commit `.env`.
#  On Koyeb, set these as Environment Variables in the service settings.
# ============================================================================

# ----------------------------- Discord --------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID from https://discord.com/developers/applications -> General Information
CLIENT_ID=000000000000000000

# Comma separated list of server (guild) IDs the bot should register commands in.
# Get a server ID: Discord -> User Settings -> Advanced -> Developer Mode ON,
# then right click the server icon -> Copy Server ID.
# Commands are registered per-guild so they appear INSTANTLY (no 1h global wait).
GUILD_IDS=111111111111111111,222222222222222222

# Optional: the guild used by `/help` style previews when the bot is in many servers.
# Leave empty to use the first entry of GUILD_IDS.
DEV_GUILD_ID=

# Optional: comma separated Discord user IDs that bypass every permission check.
BOT_ADMINS=

# ----------------------------- Supabase -------------------------------------
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service role key (NOT the anon key). Needed because the bot writes to tables
# that have Row Level Security enabled and there is no logged-in user.
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_KEY=your-service-role-key-here

# Optional. Only used if you prefer a direct Postgres connection for
# migrations/scripts. Use the Supabase POOLER url (port 6543) for serverless
# style hosting, or 5432 for a direct connection. The bot itself talks to
# Supabase over the REST API and does not need this.
DATABASE_URL=

# ----------------------------- Branding -------------------------------------
# Applied to every embed footer, the bot presence, /help and /botinfo.
BRAND_NAME=ZAYN
BRAND_DISCORD=ZAYN'S DC - whos.zayn_
BRAND_FOOTER=Built by ZAYN
# Optional extra line shown in /help and /botinfo.
BRAND_LINK=

# ----------------------------- Behaviour ------------------------------------
# Default prefix for servers that have not run `/config prefix` yet.
DEFAULT_PREFIX=.
# Set to "false" to turn the prefix command layer off bot-wide.
PREFIX_COMMANDS_ENABLED=true
# Bot-wide switch for the background scheduler (giveaways, reminders, tempbans).
TASKS_ENABLED=true
# How often the scheduler polls the database, in seconds (min 10).
TASK_INTERVAL_SECONDS=30

# Optional health-check HTTP server. Fly.io, Koyeb, Render and Railway all use it
# for liveness/readiness probes. Endpoints: / (text), /health, /ready, /metrics.
HEALTH_ENABLED=true
# The port the health server binds. Fly.io injects PORT from fly.toml's
# internal_port; Koyeb and Render inject it automatically too - so leave this
# unset on those platforms (the bot falls back to 8000 otherwise).
# Never set PORT by hand on Render: the platform must inject it, and a manual
# value is the usual cause of a "no open ports detected" deploy failure.
# Set it only for local Docker runs.
# PORT=8000

# Optional log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info
